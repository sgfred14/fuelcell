# SOFC Utility Monitor - Environment Configuration
# Copy this file to .env and adjust the values for your environment.

# -----------------------------------------------------------------------------
# Cloud MongoDB Atlas Configuration
# -----------------------------------------------------------------------------
# Standard connection string for MongoDB Atlas:
# MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority&appName=SOFCMonitor"
#
# For local MongoDB:
# MONGODB_URI="mongodb://localhost:27017"
#
# If MONGODB_URI is left blank, the backend operates in resilient local buffer mode.
MONGODB_URI="mongodb://localhost:27017/"

# MongoDB database name
MONGODB_DB_NAME=sofc_monitor

# Master switch for MongoDB storage (1 = enabled, 0 = disabled)
MONGODB_ENABLED=1

# Batch size and flush frequency for telemetry tick streaming (in seconds)
MONGODB_BATCH_SIZE=20
MONGODB_FLUSH_INTERVAL=3.0
MONGODB_MAX_BUFFER=5000

# Collection names
MONGODB_COLL_TICKS=telemetry_ticks
MONGODB_COLL_ALERTS=alerts
MONGODB_COLL_SIMS=simulations
MONGODB_COLL_CALCS=thermo_calculations

# Optional: MongoDB Atlas Data API (HTTPS REST endpoint)
MONGODB_ATLAS_DATA_API_URL=
MONGODB_ATLAS_DATA_API_KEY=
MONGODB_ATLAS_DATA_SOURCE=Cluster0

# -----------------------------------------------------------------------------
# SOFC Monitor Server Configuration
# -----------------------------------------------------------------------------
# 0 = do not autostart simulator, 1 = autostart
SIM_AUTOSTART=1

# 0 = enable learned PINN autoencoder model, 1 = physics checks only
DISABLE_AE=0

# Optional API key for POST /api/ingest
MONITOR_API_KEY=

# Allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

